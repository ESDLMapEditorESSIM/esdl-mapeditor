@startuml
' Vertical layout for more breathing room
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 80
skinparam ranksep 120

top to bottom direction

actor User

rectangle "MapEditor" as MapEditor {
    [API] as ME_API
}

rectangle "RabbitMQ\n(mapeditor.topic)" as RMQ

rectangle "Live Model Interfaces" as LMI {
    [LMI] as LMI_APP
}

rectangle "MapEditor UI" as UI {
    [Socket.IO] as ME_UI
}

User --> ME_API

ME_API --> RMQ : events.pm.new\n events.pm.add\n events.pm.delete\n events.pm\n events.pm.clear\n events.esdl.high_level_change\n {lmi_id}.activation
ME_API ..> RMQ : events.asset.positioning (disabled)

LMI_APP --> RMQ : lmi.esdl.high_level_change\n lmi.pm.refresh\n events.variant.new\n results.*

RMQ --> LMI_APP : events.pm.*\n events.esdl.high_level_change\n {lmi_id}.activation\n events.asset.positioning

RMQ --> ME_API : lmi.esdl.high_level_change\n lmi.pm.refresh\n results.*

ME_API --> ME_UI : results.asset.positioning (Socket.IO)

@enduml
